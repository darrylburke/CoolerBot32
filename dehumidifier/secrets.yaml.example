# Copy to secrets.yaml (git-ignored) and fill in. Never commit real values.
wifi_ssid: ""
wifi_password: ""
# optional second network (e.g. the bench), tried if the first is not in range
wifi_ssid_dev: ""
wifi_password_dev: ""
ap_password: ""
ota_password: ""
# MQTT broker host name (TLS, port 8883; the private CA is embedded in dehum-v1.yaml)
mqtt_broker: ""
# dehumidifier login (read/write dehum/#)
dehum_mqtt_username: ""
dehum_mqtt_password: ""
