# Copy to secrets.yaml (git-ignored) and fill in. Never commit real values.
wifi_ssid: ""
wifi_password: ""
# optional second network (e.g. the bench), tried if the first is not in range
wifi_ssid_dev: ""
wifi_password_dev: ""
ap_password: ""
ota_password: ""
# MQTT broker host name (TLS, port 8883; the private CA is embedded in cooler-v4.yaml)
mqtt_broker: ""
# controller login (read/write cooler/#)
mqtt_username: ""
mqtt_password: ""
# CoolerPanel login (used by CoolerPanel/tools/import_cooler_broker.sh)
panel_mqtt_username: ""
panel_mqtt_password: ""
# CoolerApp login (the app asks for it on first run)
app_mqtt_username: ""
app_mqtt_password: ""
