build/
.venv/
*.o

# PlatformIO's downloaded lib cache (~130 MB) and the device first-boot NVS
# seed header -- the latter embeds real Wi-Fi/MQTT credentials (see
# device/tools/gen_assets.sh). LLMMon's own .gitignore excluded these same
# paths (plus a CA seed, gone now that plain MQTT is the only mode); carried
# forward here for the same reason.
device/.pio/
device/src/assets_gen/config_seed.h

# Generated by tools/import_cooler_broker.sh — carries the live broker
# password. Regenerate after a clone; never commit.
config/cooler_defaults.h
panel_seed.json

# Python bytecode from tools/*.py
__pycache__/
